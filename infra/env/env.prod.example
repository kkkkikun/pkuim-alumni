# =============================================================================
# NMG-PKU-Alumni —— 生产/测试环境变量模板（提交到仓库，不含任何真实密钥）
#
#   cp infra/env/env.prod.example .env.prod
#   或直接执行： bash infra/scripts/init-env.sh   （自动生成随机密钥）
#
# .env.prod 已被仓库根 .gitignore 的 `.env.*` 规则忽略，不会被提交；
# 本模板文件名为 env.prod.example（不以 . 开头），可以安全提交。
# =============================================================================

# ---------------------------------------------------------------------------
# 基础
# ---------------------------------------------------------------------------
COMPOSE_PROJECT_NAME=nmg-pku-alumni
RELEASE_TAG=dev
NODE_ENV=production
TZ=Asia/Shanghai
LOG_LEVEL=info
API_PREFIX=/api/v1

# ---------------------------------------------------------------------------
# 镜像（Docker Hub 直连被阻断，统一走华为云镜像源；如镜像源不可用可改回官方名）
# ---------------------------------------------------------------------------
MYSQL_IMAGE=swr.cn-north-4.myhuaweicloud.com/ddn-k8s/docker.io/library/mysql:8.4
REDIS_IMAGE=swr.cn-north-4.myhuaweicloud.com/ddn-k8s/docker.io/library/redis:7-alpine
MINIO_IMAGE=swr.cn-north-4.myhuaweicloud.com/ddn-k8s/docker.io/minio/minio:latest
MINIO_MC_IMAGE=swr.cn-north-4.myhuaweicloud.com/ddn-k8s/docker.io/minio/mc:latest
NODE_IMAGE=swr.cn-north-4.myhuaweicloud.com/ddn-k8s/docker.io/library/node:22-alpine
NGINX_IMAGE=swr.cn-north-4.myhuaweicloud.com/ddn-k8s/docker.io/library/nginx:alpine

IMAGE_REGISTRY=nmg-pku-alumni
API_IMAGE=nmg-pku-alumni/api:latest
WORKER_IMAGE=nmg-pku-alumni/worker:latest
ADMIN_WEB_IMAGE=nmg-pku-alumni/admin-web:latest

# 构建参数
PNPM_VERSION=11.7.0
NPM_REGISTRY=https://registry.npmmirror.com/
INSTALL_FLAGS=--no-frozen-lockfile

# ---------------------------------------------------------------------------
# 端口（全部绑定 127.0.0.1；需要私网其它主机访问时把 NGINX_BIND 改为 0.0.0.0）
# ---------------------------------------------------------------------------
NGINX_BIND=127.0.0.1
NGINX_HTTP_PORT=18080
API_PORT=18081
ADMIN_PORT=18082
MYSQL_PORT=13306
REDIS_PORT=16379
MINIO_API_PORT=19000
MINIO_CONSOLE_PORT=19001

# ---------------------------------------------------------------------------
# MySQL（密码若含 @ : / ? # 等字符，需 URL 编码后再写进 DATABASE_URL）
# ---------------------------------------------------------------------------
MYSQL_ROOT_PASSWORD=CHANGE_ME_root_password
MYSQL_DATABASE=nmg_alumni
MYSQL_USER=nmg
MYSQL_PASSWORD=CHANGE_ME_app_password

# ---------------------------------------------------------------------------
# Redis
# ---------------------------------------------------------------------------
REDIS_PASSWORD=CHANGE_ME_redis_password

# ---------------------------------------------------------------------------
# MinIO（证明材料私有桶 / 公开图片桶分离）
# ---------------------------------------------------------------------------
MINIO_ROOT_USER=nmgadmin
MINIO_ROOT_PASSWORD=CHANGE_ME_minio_password
MINIO_BUCKET_PUBLIC=nmg-public
MINIO_BUCKET_PRIVATE=nmg-private

# ---------------------------------------------------------------------------
# 应用
# ---------------------------------------------------------------------------
# AUTH_MODE 三种取值：mock（仅 Mock 登录）/ wechat（仅微信登录）/ both（两者都开）。
#
# ⚠️ 生产环境**不允许** mock：API 启动期校验会直接拒绝启动
#    （docs/SECURITY.md 第 8 节）。这里默认给 both ——
#    体验版演示仍需要 Mock 登录（真机微信登录尚未切换）。
#    正式上线请改成 wechat，并填 WECHAT_APP_ID / WECHAT_APP_SECRET（属人工安排）。
AUTH_MODE=both
JWT_SECRET=CHANGE_ME_jwt_secret_at_least_32_chars_long
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=1209600
CORS_ORIGINS=http://127.0.0.1:18080
WORKER_CONCURRENCY=8
# 每个 API 实例的数据库连接池大小；口径见 docs/CONCURRENCY-DESIGN.md「连接池与实例数」。
DB_POOL_SIZE=20

# ---------------------------------------------------------------------------
# 管理后台引导账号（由 Seed 建号时使用）
# ---------------------------------------------------------------------------
# ⚠️ 默认口令 Admin@2026 是**公开在仓库里的常量**，等于没有口令。
#    生产环境必须显式提供强口令（≥12 位），否则 Seed 会拒绝建号。
#    `bash infra/scripts/init-env.sh` 会自动生成随机口令写入本文件。
ADMIN_BOOTSTRAP_USERNAME=admin
ADMIN_BOOTSTRAP_PASSWORD=CHANGE_ME_admin_password_at_least_12_chars

# ---------------------------------------------------------------------------
# 备份（服务器侧路径）
# ---------------------------------------------------------------------------
BACKUP_DIR=/home/kikun/backups/nmg-pku-alumni
BACKUP_RETENTION_DAYS=7

# ---------------------------------------------------------------------------
# 资源预算（top.md §9.4）—— compose 中已按服务写死，此处仅作留档
# ---------------------------------------------------------------------------
# docker build : 24 核 / 64GB
# mysql        : 8 核 / 32GB
# redis+minio  : 合计 8 核 / 24GB
# api+worker   : 合计 8 核 / 16GB
# tests        : 8 核 / 16GB
# k6           : 16 核 / 32GB
