# ---- 应用 ----
NODE_ENV=development
PORT=8000
API_PREFIX=/api/v1
CORS_ORIGINS=*

# ---- MySQL ----
DB_HOST=mysql
DB_PORT=3306
DB_USER=nmg
DB_PASSWORD=change-me
DB_NAME=nmg_pku_alumni
DB_LOGGING=false
# 连接池大小（每个 API 实例）。口径见 docs/CONCURRENCY-DESIGN.md「连接池与实例数」。
DB_POOL_SIZE=20

# ---- Redis / BullMQ ----
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
BULLMQ_PREFIX=nmg-bull

# ---- JWT ----
# 生成方式：`openssl rand -hex 32`（32 字节随机十六进制）。
# 生产环境必须换成**自己生成**的值：启动期校验会拒绝仓库里的占位值
# （见 src/config/config-validation.ts，docs/SECURITY.md 第 8 节）。
JWT_SECRET=change-me-to-a-long-random-string
JWT_ACCESS_TTL=2h
JWT_REFRESH_TTL=30d

# ---- 微信登录（未注册小程序前留空，走 Mock） ----
AUTH_MODE=both
WECHAT_APP_ID=
WECHAT_APP_SECRET=
WECHAT_API_BASE=https://api.weixin.qq.com

# ---- MinIO ----
# 生成方式：`openssl rand -hex 24`（对象存储的 access/secret key）。
MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=change-me
MINIO_SECRET_KEY=change-me
MINIO_BUCKET=nmg-public
MINIO_PRIVATE_BUCKET=nmg-private

# ---- 限流 ----
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_DEFAULT=240
RATE_LIMIT_WRITE=30
RATE_LIMIT_AUTH=20

# 对外可达的 API 地址（小程序直传地址拼接用）
PUBLIC_API_BASE=http://127.0.0.1:18080

# ---- 管理后台引导 ----
# ⚠️ 下面这个口令是**公开在仓库里的默认值**，只允许在开发/测试环境用。
#    生产环境必须换成自己的强口令（≥12 位）：Seed 在生产环境会拒绝用它建号。
ADMIN_BOOTSTRAP_USERNAME=admin
ADMIN_BOOTSTRAP_PASSWORD=Admin@2026

# ---- 反向代理 ----
# 信任几跳 X-Forwarded-For（限流按真实客户端 IP 计数的前提）。
# API 只绑 127.0.0.1、仅 Nginx 可达时填 1；直连部署填 0。
TRUST_PROXY_HOPS=1
