# ---- 应用 ----
NODE_ENV=development
PORT=8000
API_PREFIX=/api/v1
CORS_ORIGINS=*

# ---- MySQL ----
DB_HOST=mysql
DB_PORT=3306
DB_USER=nmg
DB_PASSWORD=change-me
DB_NAME=nmg_pku_alumni
DB_LOGGING=false

# ---- Redis / BullMQ ----
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
BULLMQ_PREFIX=nmg-bull

# ---- JWT ----
JWT_SECRET=change-me-to-a-long-random-string
JWT_ACCESS_TTL=2h
JWT_REFRESH_TTL=30d

# ---- 微信登录（未注册小程序前留空，走 Mock） ----
AUTH_MODE=both
WECHAT_APP_ID=
WECHAT_APP_SECRET=
WECHAT_API_BASE=https://api.weixin.qq.com

# ---- MinIO ----
MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=change-me
MINIO_SECRET_KEY=change-me
MINIO_BUCKET=nmg-public
MINIO_PRIVATE_BUCKET=nmg-private

# ---- 限流 ----
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_DEFAULT=240
RATE_LIMIT_WRITE=30
RATE_LIMIT_AUTH=20

# 对外可达的 API 地址（小程序直传地址拼接用）
PUBLIC_API_BASE=http://127.0.0.1:18080

# ---- 管理后台引导 ----
ADMIN_BOOTSTRAP_USERNAME=admin
ADMIN_BOOTSTRAP_PASSWORD=Admin@2026
