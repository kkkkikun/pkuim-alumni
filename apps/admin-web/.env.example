# 管理后台环境变量（复制为 .env.local 后按需覆盖）
# API 根地址，默认走同源反向代理 /api/v1
VITE_API_BASE_URL=/api/v1

# 开发期代理目标（vite dev server 的 /api 代理到哪里）
VITE_API_PROXY_TARGET=http://localhost:3000

# 开发服务器端口
VITE_DEV_PORT=5174

# 请求超时（毫秒）
VITE_API_TIMEOUT=20000

# 演示数据开关：true 时后端请求由前端 mock 适配层应答，仅用于本地开发演示
VITE_USE_MOCK=false
