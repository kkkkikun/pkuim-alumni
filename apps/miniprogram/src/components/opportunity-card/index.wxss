.opportunity {
  display: block;
  width: 100%;
  border: 1rpx solid #eee9e5;
  border-radius: 22rpx;
  padding: 28rpx 26rpx;
  background: #fff;
  margin-bottom: 20rpx;
  box-shadow: 0 6rpx 18rpx rgba(122, 69, 43, 0.03);
}

.op-top {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.type-tag {
  font-size: 20rpx;
  border-radius: 10rpx;
  padding: 6rpx 14rpx;
  font-weight: 700;
  background: #fcebea;
  color: #a72f34;
}

.type-tag.offer {
  background: #f5efe3;
  color: #987442;
}

.op-category {
  font-size: 22rpx;
  color: #a89b95;
}

.op-title {
  display: block;
  margin-top: 18rpx;
  font-size: 30rpx;
  font-weight: 700;
  color: #262322;
  line-height: 1.5;
}

.op-desc {
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #817b77;
  line-height: 1.8;
}

.op-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 20rpx;
  font-size: 21rpx;
  color: #a89b95;
}

.op-more {
  color: #a51e28;
  display: flex;
  align-items: center;
  gap: 6rpx;
}

.op-more-arrow {
  width: 22rpx;
  height: 22rpx;
  flex: none;
}

/* 缺陷 #154：此前 WXML 用了 .op-author 但没有对应样式 */
.op-author {
  color: #9c928e;
  font-size: 22rpx;
}
