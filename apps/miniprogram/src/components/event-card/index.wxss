.event {
  display: flex;
  align-items: center;
  gap: 22rpx;
  padding: 26rpx 28rpx;
  background: #fff;
  border-radius: 20rpx;
  margin-bottom: 18rpx;
  box-shadow: 0 6rpx 18rpx rgba(122, 69, 43, 0.03);
}

.event-mark {
  width: 88rpx;
  height: 88rpx;
  border-radius: 20rpx;
  background: #fbeae7;
  color: #a51e28;
  display: flex;
  align-items: center;
  justify-content: center;
  flex: none;
}

.event-mark-text {
  font-family: "Songti SC", "STSong", "SimSun", serif;
  font-size: 24rpx;
  font-weight: 700;
  padding: 0 10rpx;
  text-align: center;
}

.event-copy {
  flex: 1;
  min-width: 0;
}

.event-title {
  display: block;
  font-size: 29rpx;
  font-weight: 700;
  color: #262322;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.event-meta {
  display: block;
  margin-top: 8rpx;
  font-size: 23rpx;
  color: #8a807c;
}

.event-place {
  display: block;
  margin-top: 4rpx;
  font-size: 21rpx;
  color: #a19893;
}

.event-arrow {
  color: #c8c0bb;
  font-size: 34rpx;
  flex: none;
}
