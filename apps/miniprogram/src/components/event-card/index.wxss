.event {
  display: flex;
  align-items: center;
  gap: 22rpx;
  padding: 26rpx 28rpx;
  background: #fff;
  border-radius: 20rpx;
  margin-bottom: 18rpx;
  box-shadow: 0 6rpx 18rpx rgba(122, 69, 43, 0.03);
}

.event-mark {
  position: relative;
  width: 88rpx;
  height: 88rpx;
  border-radius: 20rpx;
  background: linear-gradient(135deg, #f9e7dc, #f3d5bd);
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
  flex: none;
}

/* 原型 .event-mark:after 的装饰圆环 */
.event-mark::after {
  content: "";
  position: absolute;
  width: 66rpx;
  height: 66rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.61);
  border-radius: 50%;
  right: -22rpx;
  bottom: -24rpx;
}

.event-mark.olive {
  background: linear-gradient(135deg, #ecede4, #d6decf);
}

.event-mark-img {
  width: 56rpx;
  height: 56rpx;
}

.event-copy {
  flex: 1;
  min-width: 0;
}

.event-title {
  display: block;
  font-size: 29rpx;
  font-weight: 700;
  color: #262322;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.event-meta {
  display: block;
  margin-top: 8rpx;
  font-size: 23rpx;
  color: #8a807c;
}

.event-place {
  display: block;
  margin-top: 4rpx;
  font-size: 21rpx;
  color: #a19893;
}

.event-arrow {
  color: #c8c0bb;
  font-size: 34rpx;
  flex: none;
}
