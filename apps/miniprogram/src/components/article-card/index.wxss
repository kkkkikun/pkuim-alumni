.article {
  display: block;
  width: 100%;
  background: #fff;
  border-radius: 20rpx;
  padding: 28rpx 26rpx;
  margin-bottom: 18rpx;
  box-shadow: 0 6rpx 18rpx rgba(122, 69, 43, 0.03);
}

.article-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.article-category {
  font-size: 21rpx;
  color: #b85f58;
  background: #f9e8e6;
  border-radius: 8rpx;
  padding: 4rpx 12rpx;
}

.article-date {
  font-size: 21rpx;
  color: #a89b95;
}

.article-title {
  display: block;
  margin-top: 16rpx;
  font-family: "Songti SC", "STSong", "SimSun", serif;
  font-size: 32rpx;
  font-weight: 700;
  color: #262322;
  line-height: 1.5;
}

.article-summary {
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #817b77;
  line-height: 1.8;
}

.article-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 20rpx;
  font-size: 21rpx;
  color: #a89b95;
}

.article-more {
  color: #a51e28;
}
