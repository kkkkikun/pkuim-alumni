<view class="tabbar">
  <view
    class="tab-item {{selected === index ? 'on' : ''}}"
    wx:for="{{list}}"
    wx:key="pagePath"
    data-path="{{item.pagePath}}"
    data-index="{{index}}"
    bindtap="onTap"
  >
    <view class="tab-icon">
      <image class="tab-icon-img" src="{{selected === index ? item.iconActive : item.icon}}" mode="aspectFit"></image>
    </view>
    <text class="tab-text">{{item.text}}</text>
  </view>
</view>
