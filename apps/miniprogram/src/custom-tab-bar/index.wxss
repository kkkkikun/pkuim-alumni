/* 自定义底部导航：沿用原型的白底细线 + 选中红色与桃色下划线 */
.tabbar {
  display: flex;
  align-items: stretch;
  height: 100rpx;
  padding-bottom: env(safe-area-inset-bottom);
  background: #fffcfb;
  border-top: 1rpx solid #f0edeb;
}

.tab-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  color: #a29c99;
  font-size: 21rpx;
  font-weight: 600;
}

.tab-item.on {
  color: #a51e28;
}

.tab-text {
  line-height: 1;
}

.tab-icon {
  position: relative;
  width: 46rpx;
  height: 46rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.tab-icon-img {
  width: 46rpx;
  height: 46rpx;
}

.tab-item.on .tab-icon::after {
  content: "";
  position: absolute;
  bottom: -14rpx;
  left: 50%;
  margin-left: -6rpx;
  width: 12rpx;
  height: 6rpx;
  border-radius: 8rpx;
  background: #d4a085;
  opacity: 0.65;
}

/*
 * 图标本身是 /assets/icons/*.png（由 infra/scripts/generate-miniprogram-assets.py
 * 从 prototype/html-v1/index.html 的 Feather 风格描边 SVG 栅格化而来）。
 * 此前这里是用 CSS 伪元素手绘的三角形/圆圈，既还原不了原型，
 * 也无法随原型改动同步 —— 缺陷 #154「细节不精致」的根因之一。
 */
