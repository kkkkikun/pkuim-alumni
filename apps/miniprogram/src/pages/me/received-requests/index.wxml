<view class="list-page">
  <state-view
    status="{{loading && items.length === 0 ? 'loading' : error ? 'error' : items.length === 0 ? 'empty' : 'idle'}}"
    error-text="{{error}}"
    empty-text="还没有收到联系申请"
    empty-desc="在通讯录中发起联系申请后，对方会在这里看到"
    bind:retry="onRetry"
  ></state-view>

  <view class="request-list" wx:if="{{items.length}}">
    <view class="request-card" wx:for="{{items}}" wx:key="id">
      <view class="request-head" data-id="{{item.id}}" bindtap="onDetailTap">
        <text class="request-name">{{item.fromName}}</text>
        <text class="tag {{item.canHandle ? '' : 'tag-grey'}}">{{item.statusLabel}}</text>
      </view>
      <view class="request-message">{{item.message}}</view>
      <view class="request-meta">{{item.dateText}}</view>
      <view class="request-actions" wx:if="{{item.canHandle}}">
        <button class="btn-ghost btn-small" data-id="{{item.id}}" bindtap="onReject">拒绝</button>
        <button class="btn-main btn-small" data-id="{{item.id}}" bindtap="onAccept">接受申请</button>
      </view>
    </view>
  </view>

  <text class="form-error" wx:if="{{actionError}}">{{actionError}}</text>
</view>

<dialog
  visible="{{dialogVisible}}"
  title="{{dialogTitle}}"
  content="{{dialogContent}}"
  confirm-text="{{dialogConfirmText}}"
  cancel-text="{{dialogCancelText}}"
  bind:confirm="onDialogConfirm"
  bind:cancel="onDialogCancel"
></dialog>
