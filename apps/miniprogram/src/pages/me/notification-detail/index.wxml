<view class="list-page">
  <state-view
    status="{{loading ? 'loading' : error ? 'error' : 'idle'}}"
    error-text="{{error}}"
    bind:retry="onRetry"
  ></state-view>

  <view class="notify-detail card" wx:if="{{!loading && !error}}">
    <view class="notify-detail-head">
      <text class="notify-detail-type">{{typeLabel}}</text>
      <text class="notify-detail-time">{{createdText}}</text>
    </view>
    <text class="notify-detail-title">{{title}}</text>
    <text class="notify-detail-body">{{body}}</text>
    <view class="notify-detail-foot">
      <text class="notify-detail-state">{{read ? '已读' : '未读'}}</text>
    </view>
  </view>
</view>
