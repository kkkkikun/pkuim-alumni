<view class="list-page">
  <state-view
    status="{{loading && items.length === 0 ? 'loading' : error ? 'error' : items.length === 0 ? 'empty' : 'idle'}}"
    error-text="{{error}}"
    empty-text="还没有建立联系"
    empty-desc="联系申请被对方接受后，会在这里建立连接记录"
    bind:retry="onRetry"
  ></state-view>

  <view class="connection-list" wx:if="{{items.length}}">
    <view class="connection-card" wx:for="{{items}}" wx:key="id" data-id="{{item.id}}" bindtap="onItemTap">
      <view class="connection-head">
        <view class="avatar avatar-sm">{{item.peerInitial}}</view>
        <view class="connection-main">
          <text class="connection-name">{{item.peerName}}</text>
          <text class="connection-meta">{{item.peerMeta}}</text>
        </view>
        <text class="menu-arrow">›</text>
      </view>
      <view class="connection-share">{{item.shareState}}</view>
      <view class="connection-contact" wx:if="{{item.peerContactVisible}}">
        <text class="connection-contact-item">电话：{{item.peerPhone}}</text>
        <text class="connection-contact-item" wx:if="{{item.peerWechat}}">微信：{{item.peerWechat}}</text>
        <text class="connection-contact-item" wx:if="{{item.peerEmail}}">邮箱：{{item.peerEmail}}</text>
      </view>
      <view class="connection-contact muted" wx:else>
        对方尚未共享联系方式，无法查看。
      </view>
    </view>
  </view>

  <view class="privacy-hint">
    <view class="shield"><image class="shield-img" src="/assets/icons/plain-shield.png" mode="aspectFit"></image></view>
    <text>联系方式由双方独立授权，可随时撤回；撤回后对方将立即无法查看。</text>
  </view>
</view>
