<view class="me">
  <view class="me-banner">
    <view class="me-user">
      <view class="me-avatar">{{logged ? '校' : '燕'}}</view>
      <view class="me-copy">
        <block wx:if="{{logged}}">
          <view class="logged-name">{{displayName || '校友'}}</view>
          <view class="me-stage">{{stageText}}</view>
        </block>
        <block wx:else>
          <view class="me-greeting">你好，校友</view>
          <button class="login-btn" bindtap="onLoginTap">点击登录</button>
          <view class="me-stage">登录后查看资料、认证与连接记录</view>
        </block>
      </view>
    </view>
  </view>

  <view class="me-body">
    <view class="verify-banner" wx:if="{{logged && !verified}}" bindtap="onMenuTap" data-target="{{pending ? 'progress' : 'verify'}}">
      <view class="verify-banner-title">{{pending ? '校友认证审核中' : '完成校友身份认证'}}</view>
      <view class="verify-banner-desc">
        {{pending ? '审核通过后即可使用联系申请、资源发布等功能' : '认证后可在通讯录中被校友找到，并申请建立联系'}}
      </view>
      <text class="verify-banner-action">›</text>
    </view>

    <view class="me-stats">
      <view class="me-stat" bindtap="onMenuTap" data-target="events">
        <text class="me-stat-num">{{eventCount}}</text>
        <text class="me-stat-label">我的活动</text>
      </view>
      <view class="me-stat" bindtap="onMenuTap" data-target="requests">
        <text class="me-stat-num">{{requestCount}}</text>
        <text class="me-stat-label">连接申请</text>
      </view>
      <view class="me-stat" bindtap="onMenuTap" data-target="posts">
        <text class="me-stat-num">{{postCount}}</text>
        <text class="me-stat-label">我的发布</text>
      </view>
    </view>

    <view class="menu-title">校友服务</view>
    <view class="menu-group card">
      <view class="menu-row" bindtap="onMenuTap" data-target="profile">
        <text class="menu-icon">名</text>
        <text class="menu-label">我的校友名片</text>
        <text class="menu-arrow">›</text>
      </view>
      <view class="menu-row" bindtap="onMenuTap" data-target="events">
        <text class="menu-icon">历</text>
        <text class="menu-label">我的活动报名</text>
        <text class="menu-arrow">›</text>
      </view>
      <view class="menu-row" bindtap="onMenuTap" data-target="connections">
        <text class="menu-icon">连</text>
        <text class="menu-label">我的连接记录</text>
        <text class="menu-arrow">›</text>
      </view>
      <view class="menu-row" bindtap="onMenuTap" data-target="notifications">
        <text class="menu-icon">知</text>
        <text class="menu-label">通知中心</text>
        <text class="menu-badge" wx:if="{{unreadCount > 0}}">{{unreadCount > 99 ? '99+' : unreadCount}}</text>
        <text class="menu-arrow">›</text>
      </view>
      <view class="menu-row" bindtap="onMenuTap" data-target="posts">
        <text class="menu-icon">发</text>
        <text class="menu-label">我发布的资源与需求</text>
        <text class="menu-arrow">›</text>
      </view>
    </view>

    <view class="menu-title">账号与组织</view>
    <view class="menu-group card">
      <view class="menu-row" bindtap="onMenuTap" data-target="privacy">
        <text class="menu-icon">隐</text>
        <text class="menu-label">隐私与授权</text>
        <text class="menu-arrow">›</text>
      </view>
      <view class="menu-row" bindtap="onMenuTap" data-target="about">
        <text class="menu-icon">燕</text>
        <text class="menu-label">关于内蒙古校友会</text>
        <text class="menu-arrow">›</text>
      </view>
      <view class="menu-row" bindtap="onMenuTap" data-target="account">
        <text class="menu-icon">设</text>
        <text class="menu-label">账号设置</text>
        <text class="menu-arrow">›</text>
      </view>
    </view>

    <view class="me-footer">
      内蒙古北京大学校友会 · 微信小程序<br />
      平台仅展示校友本人授权公开的资料
    </view>
  </view>
</view>
