<view class="detail-page page-with-fixed-bar">
  <view class="card">
    <view class="card-title">填写认证资料</view>
    <view class="card-desc">资料将提交给校友会管理员人工审核，请如实填写。</view>
  </view>

  <view class="section">
    <view class="form-item">
      <text class="form-label">真实姓名<text class="required">*</text></text>
      <input class="form-input" value="{{realName}}" maxlength="30" data-field="realName" bindinput="onInput" placeholder="与证明材料一致" />
    </view>

    <view class="form-item">
      <text class="form-label">毕业院系<text class="required">*</text></text>
      <input class="form-input" value="{{college}}" maxlength="40" data-field="college" bindinput="onInput" placeholder="例如：经济学院" />
    </view>

    <view class="form-item">
      <text class="form-label">毕业年份<text class="required">*</text></text>
      <input class="form-input" value="{{graduationYear}}" maxlength="4" type="number" data-field="graduationYear" bindinput="onInput" placeholder="例如：2015" />
    </view>

    <view class="form-item">
      <text class="form-label">学位</text>
      <input class="form-input" value="{{degree}}" maxlength="20" data-field="degree" bindinput="onInput" placeholder="例如：硕士" />
    </view>

    <view class="form-item">
      <text class="form-label">学号<text class="required">*</text></text>
      <input class="form-input" value="{{studentIdMasked}}" maxlength="30" data-field="studentIdMasked" bindinput="onInput" placeholder="可隐去中间部分，例如：1101****23" />
      <text class="form-hint">学号用于人工核验，请隐去中间若干位以保护个人信息。</text>
    </view>

    <view class="form-item">
      <text class="form-label">补充说明</text>
      <textarea class="form-textarea" value="{{remark}}" maxlength="300" data-field="remark" bindinput="onInput" placeholder="如需向审核人员补充说明，可在此填写" />
    </view>

    <view class="form-item">
      <text class="form-label">证明材料</text>
      <view class="upload-entry" bindtap="onUploadTap">
        <text class="upload-entry-text">{{attachmentCount > 0 ? '已上传 ' + attachmentCount + ' 份材料' : '上传证明材料'}}</text>
        <text class="menu-arrow">›</text>
      </view>
      <text class="form-hint">支持学信网在线验证报告、毕业证书等图片或 PDF，单个文件不超过 10MB。</text>
    </view>

    <text class="form-error" wx:if="{{submitError}}">{{submitError}}</text>

    <view class="notice-box">
      提交后进入人工审核队列，审核结果会通过站内通知告知。若需要补充材料，管理员会标注「待补充材料」，你可以在认证进度页重新提交。
    </view>
  </view>

  <view class="fixed-bar" wx:if="{{success}}">
    <view class="success-panel">
      <view class="success-title">认证申请已提交</view>
      <view class="success-desc">校友会将在 1–3 个工作日内完成审核，结果会通过通知告知。</view>
      <button class="btn-main btn-block" bindtap="onViewProgress">查看认证进度</button>
    </view>
  </view>

  <view class="fixed-bar" wx:elif="{{!success}}">
    <button class="btn-main btn-block" loading="{{submitting}}" disabled="{{submitting}}" bindtap="onSubmit">
      {{submitting ? '提交中…' : '提交认证申请'}}
    </button>
  </view>
</view>
