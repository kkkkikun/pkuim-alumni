<view class="detail-page">
  <state-view
    status="{{loading ? 'loading' : error ? 'error' : 'idle'}}"
    error-text="{{error}}"
    bind:retry="onRetry"
  ></state-view>

  <block wx:if="{{notice}}">
    <view class="notice-badge">通知公告</view>
    <view class="notice-title">{{notice.title}}</view>
    <view class="notice-meta">发布于 {{notice.dateText}} · 阅读 {{notice.viewCount}}</view>
    <view class="prose">{{notice.body}}</view>
  </block>
</view>
