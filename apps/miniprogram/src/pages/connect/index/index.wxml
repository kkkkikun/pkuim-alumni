<view class="connect">
  <view class="link-hero">
    <image class="net-art" src="/assets/art/net-art.png" mode="aspectFit"></image>
    <view class="link-hero-text">
      <view class="link-kicker">从认识校友，到彼此成就</view>
      <view class="link-title">让每一份专长<text class="link-title-line">遇见新的可能</text></view>
      <view class="link-desc">交流行业经验，分享资源需求，<text class="link-desc-line">在信任与自愿的基础上建立连接。</text></view>
      <view class="link-actions">
        <view class="link-action primary" bindtap="onPublishDemand"><image class="link-action-img" src="/assets/icons/action-plus.png" mode="aspectFit"></image>我有需求</view>
        <view class="link-action ghost" bindtap="onPublishResource"><image class="link-action-img" src="/assets/icons/action-heart.png" mode="aspectFit"></image>我能提供</view>
      </view>
    </view>
  </view>

  <view class="link-body">
    <view class="connect-toolbar">
      <!--
        ⚠️ 真机反馈（16:31）：行业筛选从下面那行「按行业方向查看」的横向 chip 行
          收进二级筛选页（那条横向滚动 chip 太多、太乱）。
          现在工具栏上「地区 / 行业」两个入口都指向同一个二级筛选页，
          与通讯录页的工具栏结构保持一致；当前生效的行业在按钮上可见。
      -->
      <view class="connect-filters">
        <view class="filter-button {{regionLabel !== '全部地区' ? 'active' : ''}}" bindtap="onFilterTap">
          <image class="filter-icon" src="/assets/icons/filter-pin.png" mode="aspectFit"></image>
          <text>地区：{{regionLabel}}</text>
          <image class="filter-icon" src="/assets/icons/filter-down.png" mode="aspectFit"></image>
        </view>
        <view class="filter-button {{industryLabel !== '全部行业' ? 'active' : ''}}" bindtap="onFilterTap">
          <text>行业：{{industryLabel}}</text>
          <image class="filter-icon" src="/assets/icons/filter-down.png" mode="aspectFit"></image>
        </view>
      </view>
      <text class="connect-result-count">找到 {{total}} 条连接信息</text>
    </view>

    <view class="link-section-title">
      <text class="section-title">按类型查看</text>
      <text class="section-sub">资源与需求双向连接</text>
    </view>

    <scroll-view class="sector-scroll" scroll-x>
      <view class="sector-row">
        <view class="sector-chip {{typeLabel === '全部' ? 'on' : ''}}" data-type="all" bindtap="onTypeTap">全部</view>
        <view class="sector-chip {{typeLabel === '我有需求' ? 'on' : ''}}" data-type="demand" bindtap="onTypeTap">我有需求</view>
        <view class="sector-chip {{typeLabel === '我能提供' ? 'on' : ''}}" data-type="resource" bindtap="onTypeTap">我能提供</view>
      </view>
    </scroll-view>

    <state-view
      status="{{loading && posts.length === 0 ? 'loading' : error ? 'error' : posts.length === 0 ? 'empty' : 'idle'}}"
      error-text="{{error}}"
      empty-text="{{filterActive ? '当前筛选条件下没有连接信息' : '当前筛选下暂时没有连接信息'}}"
      empty-desc="{{filterActive ? '可以清空筛选条件后重新浏览，或发布一条资源与需求' : '可以切换地区或行业，也可以发布一条资源与需求'}}"
      bind:retry="onRetry"
    >
      <view slot="empty-action" wx:if="{{filterActive}}">
        <view class="empty-action" bindtap="onClearFilters">清空筛选条件</view>
      </view>
    </state-view>

    <view class="post-list" wx:if="{{posts.length}}">
      <opportunity-card wx:for="{{posts}}" wx:key="id" post="{{item}}" bind:tap="onPostTap"></opportunity-card>
    </view>

    <view class="list-foot" wx:if="{{posts.length}}">{{hasMore ? '上拉加载更多' : '— 已经到底了 —'}}</view>

    <view class="flow-card">
      <view class="flow-title">一次连接，是怎样发生的？</view>
      <view class="flow-steps">
        <view class="flow-step"><view class="flow-bubble"><image class="flow-bubble-img" src="/assets/icons/flow-search.png" mode="aspectFit"></image></view><text class="flow-label">发现方向</text></view>
        <text class="flow-arrow">›</text>
        <view class="flow-step"><view class="flow-bubble"><image class="flow-bubble-img" src="/assets/icons/flow-message.png" mode="aspectFit"></image></view><text class="flow-label">提交意向</text></view>
        <text class="flow-arrow">›</text>
        <view class="flow-step"><view class="flow-bubble"><image class="flow-bubble-img" src="/assets/icons/flow-shield.png" mode="aspectFit"></image></view><text class="flow-label">双向确认</text></view>
        <text class="flow-arrow">›</text>
        <view class="flow-step"><view class="flow-bubble"><image class="flow-bubble-img" src="/assets/icons/flow-handshake.png" mode="aspectFit"></image></view><text class="flow-label">建立联系</text></view>
      </view>
    </view>
  </view>
</view>
