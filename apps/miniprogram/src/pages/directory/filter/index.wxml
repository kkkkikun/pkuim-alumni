<view class="detail-page filter-page">
  <view class="section">
    <view class="section-head">
      <text class="section-title">所在地区</text>
      <text class="section-sub">按盟市或区外校友筛选</text>
    </view>
    <view class="region-grid">
      <view class="region-option {{regionCode === '' ? 'on' : ''}}" data-code="" bindtap="onRegionTap">
        <text class="region-name">全部地区</text>
        <text class="region-count">不限地区</text>
      </view>
      <view
        class="region-option {{regionCode === item.code ? 'on' : ''}}"
        wx:for="{{regions}}"
        wx:key="code"
        data-code="{{item.code}}"
        bindtap="onRegionTap"
      >
        <text class="region-name">{{item.name}}</text>
        <text class="region-count" wx:if="{{item.alumniCount !== undefined}}">{{item.alumniCount}} 位校友</text>
        <text class="region-count" wx:else>{{item.level === 'outside' ? '区外校友' : '内蒙古'}}</text>
      </view>
    </view>
  </view>

  <view class="section">
    <view class="section-head">
      <text class="section-title">所在行业</text>
      <text class="section-sub">按行业方向筛选</text>
    </view>
    <view class="chip-row">
      <view class="chip {{industryCode === '' ? 'active' : ''}}" data-code="" bindtap="onIndustryTap">全部行业</view>
      <view
        class="chip {{industryCode === item.code ? 'active' : ''}}"
        wx:for="{{industries}}"
        wx:key="code"
        data-code="{{item.code}}"
        bindtap="onIndustryTap"
      >{{item.name}}</view>
    </view>
  </view>

  <view class="section">
    <view class="section-head">
      <text class="section-title">毕业年份</text>
      <text class="section-sub">可留空</text>
    </view>
    <view class="chip-row">
      <view class="chip {{graduationYear === 0 ? 'active' : ''}}" data-year="0" bindtap="onYearTap">不限年份</view>
      <view
        class="chip {{graduationYear === item ? 'active' : ''}}"
        wx:for="{{years}}"
        wx:key="*this"
        data-year="{{item}}"
        bindtap="onYearTap"
      >{{item}} 届</view>
    </view>
  </view>

  <view class="notice-box">筛选条件只影响通讯录，不会改变首页或其他栏目的内容。</view>

  <view class="fixed-bar">
    <view class="btn-row">
      <button class="btn-ghost btn-block" bindtap="onReset">重置</button>
      <button class="btn-main btn-block" bindtap="onConfirm">确定</button>
    </view>
  </view>
</view>
