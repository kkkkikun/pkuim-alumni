/**
 * 页面共享样式块。
 * 由各页面 wxss 通过 `@import "../../../styles/blocks.wxss";` 引入。
 * 颜色与原型保持一致（红白燕园体系）。
 */

/* ------------------------------ 通用 ------------------------------ */

.btn-row {
  display: flex;
  gap: 20rpx;
}

.btn-row .btn-main,
.btn-row .btn-soft,
.btn-row .btn-ghost {
  flex: 1;
}

.list-foot {
  padding: 34rpx 0 10rpx;
  text-align: center;
  font-size: 22rpx;
  color: #b4aaa6;
}

.picker-value {
  width: 100%;
  background: #fff;
  border: 1rpx solid #ebe5e2;
  border-radius: 18rpx;
  padding: 24rpx 22rpx;
  font-size: 28rpx;
  color: #332d2b;
}

.picker-value.placeholder {
  color: #b1a8a4;
}

.success-panel {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
  width: 100%;
}

.success-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #a51e28;
}

.success-desc {
  font-size: 24rpx;
  color: #817873;
  text-align: center;
  line-height: 1.7;
}

.shield {
  flex: none;
  width: 34rpx;
  height: 34rpx;
  border-radius: 50%;
  border: 2rpx solid #d8bdb6;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* 圆圈里的盾牌图标本体 */
.shield-img {
  width: 20rpx;
  height: 20rpx;
}

.verified {
  font-size: 18rpx;
  color: #a51e28;
  background: #fbeae7;
  border-radius: 8rpx;
  padding: 3rpx 10rpx;
}

/* ------------------------------ 正文 ------------------------------ */

.prose {
  margin-top: 26rpx;
  font-size: 29rpx;
  line-height: 1.95;
  color: #3a3533;
  white-space: pre-wrap;
  word-break: break-word;
}

.detail-hero {
  padding: 36rpx 34rpx;
  border-radius: 24rpx;
  background: linear-gradient(145deg, #ab222e, #961b29);
  color: #fff;
}

.detail-hero-kind {
  font-size: 22rpx;
  color: #fad5cf;
  letter-spacing: 1rpx;
}

.detail-hero-title {
  margin-top: 16rpx;
  font-family: "Songti SC", "STSong", "SimSun", serif;
  font-size: 40rpx;
  font-weight: 700;
  line-height: 1.45;
}

.detail-hero-status {
  display: inline-block;
  margin-top: 18rpx;
  font-size: 21rpx;
  padding: 6rpx 14rpx;
  border-radius: 10rpx;
  background: rgba(255, 255, 255, 0.18);
}

/* ------------------------------ 状态步骤 ------------------------------ */

.status-steps {
  display: flex;
  align-items: center;
  padding: 20rpx 0 10rpx;
}

.status-step {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
  flex: none;
}

.status-dot {
  width: 52rpx;
  height: 52rpx;
  border-radius: 50%;
  border: 2rpx solid #e2dad5;
  color: #a9a09b;
  font-size: 24rpx;
  text-align: center;
  line-height: 48rpx;
  background: #fff;
}

.status-step.done .status-dot {
  background: #a51e28;
  border-color: #a51e28;
  color: #fff;
}

.status-label {
  font-size: 22rpx;
  color: #a59d99;
}

.status-step.done .status-label {
  color: #a51e28;
}

.status-line {
  flex: 1;
  height: 2rpx;
  background: #e9e2de;
  margin: 0 12rpx;
  margin-bottom: 34rpx;
}

/* ------------------------------ 菜单 ------------------------------ */

.menu-group {
  padding: 0 28rpx;
}

.menu-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
  height: 106rpx;
  border-bottom: 1rpx solid #f5f2ef;
}

.menu-row:last-child {
  border-bottom: none;
}

.menu-icon {
  width: 62rpx;
  height: 62rpx;
  flex: none;
  border-radius: 18rpx;
  background: #fbf5f1;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* 菜单图标本体：原型是 20px 的描边 SVG，放在 31px 的浅色圆角方块里 */
.menu-icon-img {
  width: 38rpx;
  height: 38rpx;
}

.menu-label {
  flex: 1;
  font-size: 28rpx;
  color: #332d2b;
}

.menu-arrow {
  color: #c8c0bb;
  font-size: 32rpx;
}

/* 未读角标 */
.menu-badge {
  min-width: 36rpx;
  height: 36rpx;
  padding: 0 10rpx;
  border-radius: 999rpx;
  background: #a51e28;
  color: #fff;
  font-size: 20rpx;
  line-height: 36rpx;
  text-align: center;
}

/* ------------------------------ 开关 ------------------------------ */

.toggle-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 26rpx 0;
  border-bottom: 1rpx solid #f5f2ef;
}

.toggle-row:last-child {
  border-bottom: none;
}

.toggle-copy {
  flex: 1;
  min-width: 0;
}

.toggle-title {
  display: block;
  font-size: 27rpx;
  color: #332d2b;
}

.toggle-desc {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #a19893;
  line-height: 1.7;
}

/* ------------------------------ 名单类卡片 ------------------------------ */

.registration-list,
.request-list,
.connection-list,
.history-list {
  margin-top: 6rpx;
}

.registration-card,
.request-card,
.connection-card,
.history-card {
  background: #fff;
  border-radius: 22rpx;
  padding: 26rpx;
  margin-bottom: 18rpx;
  box-shadow: 0 6rpx 18rpx rgba(122, 69, 43, 0.03);
}

.registration-main {
  flex: 1;
  min-width: 0;
}

.registration-title {
  display: block;
  font-size: 29rpx;
  font-weight: 700;
  color: #262322;
}

.registration-meta {
  display: block;
  margin-top: 8rpx;
  font-size: 23rpx;
  color: #8a807c;
}

.registration-place {
  display: block;
  margin-top: 4rpx;
  font-size: 21rpx;
  color: #a19893;
}

.request-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.request-name {
  font-size: 29rpx;
  font-weight: 700;
  color: #262322;
}

.request-message {
  margin-top: 14rpx;
  font-size: 25rpx;
  color: #6f6866;
  line-height: 1.75;
}

.request-meta {
  margin-top: 12rpx;
  font-size: 21rpx;
  color: #a19893;
}

.request-actions {
  display: flex;
  justify-content: flex-end;
  gap: 18rpx;
  margin-top: 22rpx;
}

.connection-head {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.connection-main {
  flex: 1;
  min-width: 0;
}

.connection-name {
  display: block;
  font-size: 29rpx;
  font-weight: 700;
  color: #262322;
}

.connection-meta {
  display: block;
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #a19893;
}

.connection-share {
  margin-top: 18rpx;
  font-size: 23rpx;
  color: #8a807c;
}

.connection-contact {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #a51e28;
}

.connection-contact-item {
  display: block;
  margin-top: 6rpx;
}

.history-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.history-name {
  font-size: 28rpx;
  font-weight: 700;
  color: #262322;
}

.history-meta {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #a19893;
}

.history-review {
  margin-top: 14rpx;
  font-size: 24rpx;
  color: #6f6866;
  line-height: 1.7;
}

/* ------------------------------ 发布列表 ------------------------------ */

.post-list {
  margin-top: 6rpx;
}

.post-item {
  background: #fff;
  border-radius: 22rpx;
  padding: 26rpx;
  margin-bottom: 18rpx;
  box-shadow: 0 6rpx 18rpx rgba(122, 69, 43, 0.03);
}

.post-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.post-status {
  font-size: 21rpx;
  color: #a89b95;
}

.post-title {
  display: block;
  margin-top: 16rpx;
  font-size: 29rpx;
  font-weight: 700;
  color: #262322;
  line-height: 1.5;
}

.post-body {
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #817b77;
  line-height: 1.8;
}

.post-time {
  display: block;
  margin-top: 16rpx;
  font-size: 21rpx;
  color: #a89b95;
}

/* ------------------------------ 个人主页头 ------------------------------ */

.profile-head {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 34rpx 30rpx;
  background: #fff;
  border-radius: 24rpx;
  margin-bottom: 24rpx;
}

.profile-avatar {
  width: 116rpx;
  height: 116rpx;
  border-radius: 50%;
  background: #ad3137;
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-family: "Songti SC", "STSong", "SimSun", serif;
  font-size: 46rpx;
  flex: none;
}

.profile-copy {
  flex: 1;
  min-width: 0;
}

.profile-name {
  display: flex;
  align-items: center;
  gap: 14rpx;
  font-size: 34rpx;
  font-weight: 700;
  color: #262322;
}

.profile-meta {
  margin-top: 10rpx;
  font-size: 23rpx;
  color: #987f7e;
}

.action-hint {
  display: block;
  margin-top: 14rpx;
  text-align: center;
  font-size: 21rpx;
  color: #a19893;
}

/* ------------------------------ 公告列表（首页 + 公告页共用） ------------------------------ */
/* ⚠️ 缺陷 #154：这些类此前只在 WXML 里用、**没有任何 WXSS 定义**，
   真机上公告列表是裸文字。放在共享块里，两处一起生效。 */

.notice-list {
  margin-top: 8rpx;
}

.notice-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  padding: 26rpx 0;
  border-bottom: 2rpx solid #f0eded;
}

.notice-item-main {
  flex: 1;
  min-width: 0;
}

.notice-item-title {
  display: block;
  font-size: 28rpx;
  line-height: 1.5;
  color: #262322;
}

.notice-item-date {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #a69a94;
}

.notice-arrow {
  flex: none;
  color: #c4bcb8;
  font-size: 30rpx;
  line-height: 1;
}

.empty-mini {
  padding: 80rpx 0;
  text-align: center;
  color: #a19893;
  font-size: 26rpx;
}

/* 分组标题（profile-edit 用；此前 WXML 用了但没有定义） */
.menu-title {
  margin: 34rpx 0 18rpx;
  font-size: 25rpx;
  font-weight: 700;
  color: #4f4642;
}
